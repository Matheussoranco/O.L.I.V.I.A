+++ b/tests/_meta/test_shell_portability.py
@@ -0,0 +1,47 @@
+"""Windows Git modes and shell paths must retain the structural checks."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from skill_contract import structure
+
+
+@pytest.mark.parametrize("mode,returncode,expected", [
+    ("100755", 0, True), ("100644", 0, False), ("100755", 1, False),
+])
+def test_windows_checks_tracked_executable_mode(monkeypatch, tmp_path, mode, returncode, expected):
+    script = tmp_path / "script with spaces.sh"
+    runner = Mock(return_value=SimpleNamespace(returncode=returncode, stdout=f"{mode} abc 0\t{script.name}\n"))
+    monkeypatch.setattr(structure.sys, "platform", "win32")
+    monkeypatch.setattr(structure.subprocess, "run", runner)
+    assert structure._shell_executable(script) is expected
+    assert runner.call_args.args[0] == [
+        "git", "-C", str(script.parent), "ls-files", "--stage", "--error-unmatch", "--", script.name,
+    ]
+
+
+@pytest.mark.parametrize("mode,expected", [(0o755, True), (0o644, False)])
+def test_posix_checks_filesystem_executable_mode(monkeypatch, mode, expected):
+    monkeypatch.setattr(structure.sys, "platform", "linux")
+    script = SimpleNamespace(stat=lambda: SimpleNamespace(st_mode=mode))
+    assert structure._shell_executable(script) is expected
+
+
+def test_windows_prefers_git_bash_and_keeps_path_one_argument(monkeypatch, tmp_path):
+    git = tmp_path / "Git" / "cmd" / "git.exe"
+    bash = git.parent.parent / "bin" / "bash.exe"
+    bash.parent.mkdir(parents=True)
+    bash.touch()
+    script = tmp_path / "skill with spaces" / "script.sh"
+    monkeypatch.setattr(structure.sys, "platform", "win32")
+    monkeypatch.setattr(structure.shutil, "which", lambda name: str(git) if name == "git" else "wsl-bash")
+    assert structure._shell_syntax_command(script) == [str(bash), "-n", script.resolve().as_posix()]
+
+
+def test_posix_keeps_available_shell(monkeypatch, tmp_path):
+    monkeypatch.setattr(structure.sys, "platform", "linux")
+    monkeypatch.setattr(structure.shutil, "which", lambda name: "/usr/bin/bash")
+    script = tmp_path / "script.sh"
+    assert structure._shell_syntax_command(script) == ["/usr/bin/bash", "-n", script.resolve().as_posix()]
