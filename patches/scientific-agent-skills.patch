+    )
+    return result.returncode == 0 and result.stdout.startswith("100755 ")
+
+
+def _shell_syntax_command(path: Path) -> list[str]:
+    shell = shutil.which("bash") or "bash"
+    if sys.platform == "win32":
+        git = shutil.which("git")
+        if git:
+            for parent in Path(git).parents:
+                candidate = parent / "bin" / "bash.exe"
+                if candidate.is_file():
+                    shell = str(candidate)
+                    break
+    return [shell, "-n", path.resolve().as_posix()]
+
