diff --git a/skills/hypothesis-generation/scripts/_private_file.py b/skills/hypothesis-generation/scripts/_private_file.py
new file mode 100644
index 0000000..a211aa5
--- /dev/null
+++ b/skills/hypothesis-generation/scripts/_private_file.py
@@ -0,0 +1,149 @@
+"""Owner-only file creation, before the first write, using only the standard library."""
+from __future__ import annotations
+
+import os
+import secrets
+import tempfile
+from pathlib import Path
+
+
+def private_open(path: str | Path) -> int:
+    """Create exclusively; an existing path is never opened or truncated."""
+    if os.name != "nt":
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(path, flags, 0o600)
+        try:
+            os.fchmod(fd, 0o600)
+        except BaseException:
+            os.close(fd)
+            Path(path).unlink(missing_ok=True)
+            raise
+        return fd
+    return _windows_open(Path(path).absolute())
+
+
+def private_mkstemp(*, dir: Path, prefix: str, suffix: str = ".tmp") -> tuple[int, str]:
+    if os.name != "nt":
+        fd, name = tempfile.mkstemp(dir=dir, prefix=prefix, suffix=suffix)
+        try:
+            os.fchmod(fd, 0o600)
+        except BaseException:
+            os.close(fd)
+            Path(name).unlink(missing_ok=True)
+            raise
+        return fd, name
+    for _ in range(100):
+        name = str(dir / f"{prefix}{secrets.token_hex(16)}{suffix}")
+        try:
+            return private_open(name), name
+        except FileExistsError:
+            continue
+    raise FileExistsError("Could not reserve a private temporary file")
+
+
+def _windows_open(path: Path) -> int:
+    import ctypes
+    import msvcrt
+    from ctypes import wintypes as w
+
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    security = ctypes.WinDLL("advapi32", use_last_error=True)
+    pointer = ctypes.c_void_p
+    ppointer = ctypes.POINTER(pointer)
+    kernel.GetCurrentThread.restype = w.HANDLE
+    kernel.GetCurrentProcess.restype = w.HANDLE
+    kernel.CloseHandle.argtypes = [w.HANDLE]
+    kernel.LocalFree.argtypes = [pointer]
+    kernel.LocalFree.restype = pointer
+    security.OpenThreadToken.argtypes = [w.HANDLE, w.DWORD, w.BOOL, ctypes.POINTER(w.HANDLE)]
+    security.OpenProcessToken.argtypes = [w.HANDLE, w.DWORD, ctypes.POINTER(w.HANDLE)]
+    security.GetTokenInformation.argtypes = [w.HANDLE, w.DWORD, pointer, w.DWORD, ctypes.POINTER(w.DWORD)]
+    security.ConvertSidToStringSidW.argtypes = [pointer, ctypes.POINTER(w.LPWSTR)]
+    security.ConvertStringSecurityDescriptorToSecurityDescriptorW.argtypes = [w.LPCWSTR, w.DWORD, ppointer, ctypes.POINTER(w.DWORD)]
+    security.GetSecurityInfo.argtypes = [w.HANDLE, w.DWORD, w.DWORD, ppointer, ppointer, ppointer, ppointer, ppointer]
+    security.GetSecurityInfo.restype = w.DWORD
+    security.GetSecurityDescriptorControl.argtypes = [pointer, ctypes.POINTER(w.WORD), ctypes.POINTER(w.DWORD)]
+    security.GetAce.argtypes = [pointer, w.DWORD, ppointer]
+    security.EqualSid.argtypes = [pointer, pointer]
+
+    class Attributes(ctypes.Structure):
+        _fields_ = [("length", w.DWORD), ("descriptor", pointer), ("inherit", w.BOOL)]
+
+    kernel.CreateFileW.argtypes = [w.LPCWSTR, w.DWORD, w.DWORD, ctypes.POINTER(Attributes), w.DWORD, w.DWORD, w.HANDLE]
+    kernel.CreateFileW.restype = w.HANDLE
+    token = w.HANDLE()
+    sid_text = w.LPWSTR()
+    descriptor = pointer()
+    actual_descriptor = pointer()
+    handle = None
+    created = False
+    try:
+        # Honor impersonation when present; only ERROR_NO_TOKEN permits fallback.
+        if not security.OpenThreadToken(kernel.GetCurrentThread(), 0x0008, True, ctypes.byref(token)):
+            if ctypes.get_last_error() != 1008:
+                raise ctypes.WinError(ctypes.get_last_error())
+            if not security.OpenProcessToken(kernel.GetCurrentProcess(), 0x0008, ctypes.byref(token)):
+                raise ctypes.WinError(ctypes.get_last_error())
+        size = w.DWORD()
+        security.GetTokenInformation(token, 1, None, 0, ctypes.byref(size))
+        if not size.value:
+            raise ctypes.WinError(ctypes.get_last_error())
+        user = ctypes.create_string_buffer(size.value)
+        if not security.GetTokenInformation(token, 1, user, size.value, ctypes.byref(size)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        sid = ctypes.cast(user, ppointer)[0]
+        if not security.ConvertSidToStringSidW(sid, ctypes.byref(sid_text)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        sddl = f"O:{sid_text.value}D:P(A;;FA;;;{sid_text.value})"
+        if not security.ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, 1, ctypes.byref(descriptor), None):
+            raise ctypes.WinError(ctypes.get_last_error())
+        attributes = Attributes(ctypes.sizeof(Attributes), descriptor, False)
+        handle = kernel.CreateFileW(str(path), 0xC0000000, 0, ctypes.byref(attributes), 1, 0x80, None)
+        if handle == pointer(-1).value:
+            handle = None
+            raise ctypes.WinError(ctypes.get_last_error())
+        created = True
+        owner, acl, ace = pointer(), pointer(), pointer()
+        error = security.GetSecurityInfo(handle, 1, 0x00000001 | 0x00000004,
+                                         ctypes.byref(owner), None, ctypes.byref(acl), None,
+                                         ctypes.byref(actual_descriptor))
+        if error:
+            raise ctypes.WinError(error)
+        control, revision = w.WORD(), w.DWORD()
+        if not security.GetSecurityDescriptorControl(actual_descriptor, ctypes.byref(control), ctypes.byref(revision)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if not acl.value or not owner.value or not control.value & 0x1000:
+            raise PermissionError("Filesystem did not enforce a protected private DACL")
+        acl_header = ctypes.string_at(acl, 8)
+        if int.from_bytes(acl_header[4:6], "little") != 1 or not security.GetAce(acl, 0, ctypes.byref(ace)):
+            raise PermissionError("Private DACL must contain exactly one owner ACE")
+        ace_header = ctypes.string_at(ace, 8)
+        if (ace_header[:2] != b"\x00\x00" or int.from_bytes(ace_header[4:8], "little") != 0x001F01FF
+                or not security.EqualSid(owner, sid) or not security.EqualSid(pointer(ace.value + 8), sid)):
+            raise PermissionError("Filesystem did not enforce owner-only file access")
+        fd = msvcrt.open_osfhandle(handle, os.O_RDWR | os.O_BINARY)
+        handle = None  # The CRT descriptor now owns the handle.
+        try:
+            os.set_inheritable(fd, False)
+        except BaseException:
+            os.close(fd)
+            raise
+        return fd
+    except BaseException:
+        if handle is not None:
+            kernel.CloseHandle(handle)
+            handle = None
+        if created:
+            path.unlink(missing_ok=True)
+        raise
+    finally:
+        if handle is not None:
+            kernel.CloseHandle(handle)
+        if actual_descriptor.value:
+            kernel.LocalFree(actual_descriptor)
+        if descriptor.value:
+            kernel.LocalFree(descriptor)
+        if sid_text:
+            kernel.LocalFree(ctypes.cast(sid_text, pointer))
+        if token.value:
+            kernel.CloseHandle(token)
