+            raise ctypes.WinError(ctypes.get_last_error())
+        sid = ctypes.cast(user, ppointer)[0]
+        if not security.ConvertSidToStringSidW(sid, ctypes.byref(sid_text)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        sddl = f"O:{sid_text.value}D:P(A;;FA;;;{sid_text.value})"
+        if not security.ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, 1, ctypes.byref(descriptor), None):
+            raise ctypes.WinError(ctypes.get_last_error())
+        attributes = Attributes(ctypes.sizeof(Attributes), descriptor, False)
+        handle = kernel.CreateFileW(str(path), 0xC0000000, 0, ctypes.byref(attributes), 1, 0x80, None)
+        if handle == pointer(-1).value:
+            handle = None
+            raise ctypes.WinError(ctypes.get_last_error())
+        created = True
+        owner, acl, ace = pointer(), pointer(), pointer()
+        error = security.GetSecurityInfo(handle, 1, 0x00000001 | 0x00000004,
+                                         ctypes.byref(owner), None, ctypes.byref(acl), None,
+                                         ctypes.byref(actual_descriptor))
+        if error:
+            raise ctypes.WinError(error)
+        control, revision = w.WORD(), w.DWORD()
+        if not security.GetSecurityDescriptorControl(actual_descriptor, ctypes.byref(control), ctypes.byref(revision)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if not acl.value or not owner.value or not control.value & 0x1000:
+            raise PermissionError("Filesystem did not enforce a protected private DACL")
+        acl_header = ctypes.string_at(acl, 8)
+        if int.from_bytes(acl_header[4:6], "little") != 1 or not security.GetAce(acl, 0, ctypes.byref(ace)):
+            raise PermissionError("Private DACL must contain exactly one owner ACE")
+        ace_header = ctypes.string_at(ace, 8)
+        if (ace_header[:2] != b"\x00\x00" or int.from_bytes(ace_header[4:8], "little") != 0x001F01FF
+                or not security.EqualSid(owner, sid) or not security.EqualSid(pointer(ace.value + 8), sid)):
+            raise PermissionError("Filesystem did not enforce owner-only file access")
+        fd = msvcrt.open_osfhandle(handle, os.O_RDWR | os.O_BINARY)
+        handle = None  # The CRT descriptor now owns the handle.
+        try:
+            os.set_inheritable(fd, False)
+        except BaseException:
+            os.close(fd)
+            raise
+        return fd
+    except BaseException:
+        if handle is not None:
+            kernel.CloseHandle(handle)
+            handle = None
+        if created:
+            path.unlink(missing_ok=True)
+        raise
+    finally:
+        if handle is not None:
+            kernel.CloseHandle(handle)
+        if actual_descriptor.value:
+            kernel.LocalFree(actual_descriptor)
+        if descriptor.value:
+            kernel.LocalFree(descriptor)
+        if sid_text:
+            kernel.LocalFree(ctypes.cast(sid_text, pointer))
+        if token.value:
+            kernel.CloseHandle(token)
