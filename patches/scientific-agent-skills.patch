+"""Independent native permission checks for the per-skill private writers."""
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+
+def assert_private_file(path: Path) -> None:
+    if os.name != 'nt':
+        assert stat.S_IMODE(path.stat().st_mode) == 0o600
+        return
+    literal = str(path.absolute()).replace("'", "''")
+    script = (
+        "$ErrorActionPreference='Stop'; "
+        f"$acl=[System.IO.File]::GetAccessControl('{literal}'); "
+        "$sidType=[System.Security.Principal.SecurityIdentifier]; "
+        "$owner=$acl.GetOwner($sidType).Value; "
+        "$current=[System.Security.Principal.WindowsIdentity]::GetCurrent().User.Value; "
+        "$rules=@($acl.GetAccessRules($true,$true,$sidType)); "
+        "@{protected=$acl.AreAccessRulesProtected; ownerMatches=($owner -eq $current); "
+        "oneOwnerRule=($rules.Count -eq 1 -and $rules[0].IdentityReference.Value -eq $owner "
+        "-and $rules[0].AccessControlType -eq 'Allow' -and -not $rules[0].IsInherited "
+        "-and $rules[0].FileSystemRights -eq 'FullControl')} | ConvertTo-Json -Compress"
+    )
+    result = subprocess.run(['powershell.exe', '-NoProfile', '-NonInteractive', '-Command', script],
+                            capture_output=True, text=True, timeout=20)
+    assert result.returncode == 0, result.stderr
+    checks = json.loads(result.stdout)
+    assert checks == {'protected': True, 'ownerMatches': True, 'oneOwnerRule': True}, checks
+
+
+def creation_test_case(skill_root: Path):
+    """Run these only in that skill's isolated process, never in the meta suite."""
+    spec = importlib.util.spec_from_file_location(
+        'private_creation_under_test', skill_root / 'scripts' / '_private_file.py'
+    )
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    class PrivateCreationTests(unittest.TestCase):
+        @unittest.skipIf(os.name == 'nt', 'POSIX umask contract')
+        def test_restrictive_umask_preserves_owner_read_and_write(self):
+            with tempfile.TemporaryDirectory() as directory:
+                previous = os.umask(0o777)
+                try:
+                    for create in (lambda: (module.private_open(Path(directory) / 'file.bin'), str(Path(directory) / 'file.bin')),
+                                   lambda: module.private_mkstemp(dir=Path(directory), prefix='temp-')):
+                        fd, name = create()
+                        try:
+                            os.write(fd, b'owner content')
+                            assert_private_file(Path(name))
+                        finally:
+                            os.close(fd)
+                        self.assertEqual(Path(name).read_bytes(), b'owner content')
+                finally:
+                    os.umask(previous)
+
+        def test_private_before_first_write_and_collision_preserves_content(self):
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / 'private.bin'
+                fd = module.private_open(path)
+                try:
+                    self.assertFalse(os.get_inheritable(fd))
+                    self.assertEqual(os.fstat(fd).st_size, 0)
+                    assert_private_file(path)
+                    os.write(fd, b'original')
+                finally:
+                    os.close(fd)
+                with self.assertRaises(FileExistsError):
+                    module.private_open(path)
+                self.assertEqual(path.read_bytes(), b'original')
+                assert_private_file(path)
+
+        @unittest.skipUnless(os.name == 'nt', 'Windows handle security API')
+        def test_unavailable_acl_verification_fails_closed_and_cleans_up(self):
+            import ctypes
+            original = ctypes.WinDLL
+
+            class SecurityProxy:
+                def __init__(self, real):
+                    self.real = real
+                    self.GetSecurityInfo = lambda *args: 50  # ERROR_NOT_SUPPORTED
+                def __getattr__(self, name):
+                    return getattr(self.real, name)
+
+            def library(name, **kwargs):
+                real = original(name, **kwargs)
+                return SecurityProxy(real) if name == 'advapi32' else real
+
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / 'unsupported.bin'
+                with mock.patch.object(ctypes, 'WinDLL', side_effect=library):
+                    with self.assertRaises(OSError):
+                        module.private_open(path)
+                self.assertFalse(path.exists())
+
+    return PrivateCreationTests
+
+
+def publishing_test_case(common):
+    class PrivatePublishingTests(unittest.TestCase):
+        def test_no_force_publication_never_overwrites_a_concurrent_file(self):
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / 'report.json'
+                original = os.link
+                def collision(source, destination):
+                    Path(destination).write_bytes(b'concurrent output')
+                    return original(source, destination)
+                with mock.patch.object(common.os, 'link', side_effect=collision):
+                    with self.assertRaises(common.ValidationError):
+                        common.atomic_write_text(path, 'private content')
+                self.assertEqual(path.read_bytes(), b'concurrent output')
+                self.assertEqual(list(Path(directory).glob('.*.tmp')), [])
+
+        def test_forced_replacement_is_private_and_failure_removes_temporaries(self):
+            with tempfile.TemporaryDirectory() as directory:
+                path = Path(directory) / 'report.json'
+                path.write_text('old')
+                common.atomic_write_text(path, 'new', force=True)
+                self.assertEqual(path.read_text(), 'new')
+                assert_private_file(path)
+                with mock.patch.object(common.os, 'fsync', side_effect=OSError('controlled failure')):
+                    with self.assertRaises(common.ValidationError):
+                        common.atomic_write_text(path, 'never publish', force=True)
+                self.assertEqual(path.read_text(), 'new')
+                self.assertEqual(list(Path(directory).glob('.*.tmp')), [])
+
+    return PrivatePublishingTests
